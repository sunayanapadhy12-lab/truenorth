# TrueNorth Environment Variables

# Supabase PostgreSQL Configuration
# (Optional for local testing; app runs in in-memory Mock Mode if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI API Configuration
# (Optional for deterministic rules; app runs rules + keyword fallback if omitted)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Abuse Prevention & Cost Limits
GEMINI_DAILY_CALL_CAP=100
SESSION_RATE_LIMIT_PER_MINUTE=10

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
